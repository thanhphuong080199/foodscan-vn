# Copy to .env and fill in. .env is gitignored — never commit your real key.
# Get a free key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_key_here

# Optional: override the model fallback chain (comma-separated, tried in order).
# On rate-limit (HTTP 429) the client advances to the next model.
# EXPO_PUBLIC_GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite

# Food photos on the detail screen come from Wikimedia Commons — no API key
# required.
